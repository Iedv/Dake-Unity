--- !u!114 &1746573299
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1746573297}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: ef85b4c237c8faf4f92d8037bf9e86e5, type: 3}
    m_FontSize: 40
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 4
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "2.1 \u5E38\u89C1\u7684\u5B89\u5168\u6F0F\u6D1E\u7C7B\u578B\n\n\u5B89\u5168\u6F0F\u6D1E\u662F\u7F51\u7EDC\u653B\u51FB\u7684\u4E3B\u8981\u5165\u53E3\uFF0C\u4E86\u89E3\u5E38\u89C1\u7684\u5B89\u5168\u6F0F\u6D1E\u7C7B\u578B\u5BF9\u4E8E\u9632\u8303\u653B\u51FB\u81F3\u5173\u91CD\u8981\u3002\u4EE5\u4E0B\u662F\u4E00\u4E9B\u5E38\u89C1\u7684\u5B89\u5168\u6F0F\u6D1E\u7C7B\u578B\uFF1A\r\n\r\n\u7F13\u51B2\u533A\u6EA2\u51FA\uFF1A\u5F53\u7A0B\u5E8F\u8BD5\u56FE\u5411\u7F13\u51B2\u533A\u5199\u5165\u8D85\u51FA\u5176\u5BB9\u91CF\u7684\u6570\u636E\u65F6\uFF0C\u4F1A\u5BFC\u81F4\u7F13\u51B2\u533A\u6EA2\u51FA\u3002\u653B\u51FB\u8005\u53EF\u4EE5\u5229\u7528\u8FD9\u4E00\u6F0F\u6D1E\u6267\u884C\u4EFB\u610F\u4EE3\u7801\uFF0C\u751A\u81F3\u63A7\u5236\u6574\u4E2A\u7CFB\u7EDF\u3002\n\r\nSQL\u6CE8\u5165\uFF1ASQL\u6CE8\u5165\u662F\u4E00\u79CD\u5E38\u89C1\u7684Web\u5E94\u7528\u6F0F\u6D1E\uFF0C\u653B\u51FB\u8005\u901A\u8FC7\u5728\u8F93\u5165\u5B57\u6BB5\u4E2D\u63D2\u5165\u6076\u610FSQL\u4EE3\u7801\uFF0C\u53EF\u4EE5\u64CD\u7EB5\u6570\u636E\u5E93\uFF0C\u83B7\u53D6\u654F\u611F\u4FE1\u606F\u6216\u7834\u574F\u6570\u636E\u3002\r\n\n\r\u8DE8\u7AD9\u811A\u672C\uFF08XSS\uFF09\uFF1AXSS\u6F0F\u6D1E\u5141\u8BB8\u653B\u51FB\u8005\u5C06\u6076\u610F\u811A\u672C\u6CE8\u5165\u5230\u7F51\u9875\u4E2D\uFF0C\u5F53\u5176\u4ED6\u7528\u6237\u8BBF\u95EE\u8BE5\u7F51\u9875\u65F6\uFF0C\u6076\u610F\u811A\u672C\u4F1A\u5728\u4ED6\u4EEC\u7684\u6D4F\u89C8\u5668\u4E2D\u6267\u884C\uFF0C\u7A83\u53D6Cookie\u6216\u4F1A\u8BDD\u4FE1\u606F\u3002\n\r\n\r\u8DE8\u7AD9\u8BF7\u6C42\u4F2A\u9020\uFF08CSRF\uFF09\uFF1ACSRF\u653B\u51FB\u5229\u7528\u7528\u6237\u7684\u767B\u5F55\u72B6\u6001\uFF0C\u8BF1\u4F7F\u7528\u6237\u5728\u4E0D\u77E5\u60C5\u7684\u60C5\u51B5\u4E0B\u6267\u884C\u67D0\u4E9B\u64CD\u4F5C\uFF0C\u5982\u8F6C\u8D26\u3001\u4FEE\u6539\u5BC6\u7801\u7B49\u3002\r\n\n\r\u6587\u4EF6\u5305\u542B\u6F0F\u6D1E\uFF1A\u6587\u4EF6\u5305\u542B\u6F0F\u6D1E\u5141\u8BB8\u653B\u51FB\u8005\u5305\u542B\u5E76\u6267\u884C\u670D\u52A1\u5668\u4E0A\u7684\u4EFB\u610F\u6587\u4EF6\uFF0C\u53EF\u80FD\u5BFC\u81F4\u654F\u611F\u4FE1\u606F\u6CC4\u9732\u6216\u7CFB\u7EDF\u88AB\u63A7\u5236\u3002\r\n\r\u4E0D\u5B89\u5168\u7684\u76F4\u63A5\u5BF9\u8C61\u5F15\u7528\uFF08IDOR\uFF09\uFF1A\u5F53\u5E94\u7528\u7A0B\u5E8F\u76F4\u63A5\u4F7F\u7528\u7528\u6237\u63D0\u4F9B\u7684\u8F93\u5165\u6765\u8BBF\u95EE\u5BF9\u8C61\u65F6\uFF0C\u653B\u51FB\u8005\u53EF\u4EE5\u901A\u8FC7\u4FEE\u6539\u8F93\u5165\u53C2\u6570\u6765\u8BBF\u95EE\u672A\u6388\u6743\u7684\u8D44\u6E90\u3002\r\n\n\r\u5B89\u5168\u914D\u7F6E\u9519\u8BEF\uFF1A\u8BB8\u591A\u5B89\u5168\u6F0F\u6D1E\u662F\u7531\u4E8E\u7CFB\u7EDF\u6216\u5E94\u7528\u7A0B\u5E8F\u7684\u914D\u7F6E\u4E0D\u5F53\u5F15\u8D77\u7684\uFF0C\u5982\u9ED8\u8BA4\u5BC6\u7801\u672A\u4FEE\u6539\u3001\u4E0D\u5FC5\u8981\u7684\u670D\u52A1\u672A\u5173\u95ED\u7B49\u3002\n\r\n2.2
    \u5E38\u89C1\u7684\u653B\u51FB\u65B9\u6CD5\n\n\u4E86\u89E3\u5E38\u89C1\u7684\u653B\u51FB\u65B9\u6CD5\u6709\u52A9\u4E8E\u66F4\u597D\u5730\u9632\u8303\u7F51\u7EDC\u653B\u51FB\u3002\u4EE5\u4E0B\u662F\u4E00\u4E9B\u5E38\u89C1\u7684\u653B\u51FB\u65B9\u6CD5\uFF1A\r\n\r\n\u7AEF\u53E3\u626B\u63CF\uFF1A\u7AEF\u53E3\u626B\u63CF\u662F\u653B\u51FB\u8005\u5E38\u7528\u7684\u4FE1\u606F\u6536\u96C6\u624B\u6BB5\uFF0C\u901A\u8FC7\u626B\u63CF\u76EE\u6807\u7CFB\u7EDF\u7684\u5F00\u653E\u7AEF\u53E3\uFF0C\u653B\u51FB\u8005\u53EF\u4EE5\u4E86\u89E3\u7CFB\u7EDF\u8FD0\u884C\u7684\u670D\u52A1\uFF0C\u5E76\u5BFB\u627E\u6F5C\u5728\u7684\u6F0F\u6D1E\u3002\r\n\r\n\u62D2\u7EDD\u670D\u52A1\u653B\u51FB\uFF08DoS/DDoS\uFF09\uFF1ADoS\u653B\u51FB\u901A\u8FC7\u5411\u76EE\u6807\u7CFB\u7EDF\u53D1\u9001\u5927\u91CF\u8BF7\u6C42\uFF0C\u8017\u5C3D\u7CFB\u7EDF\u8D44\u6E90\uFF0C\u4F7F\u5176\u65E0\u6CD5\u6B63\u5E38\u63D0\u4F9B\u670D\u52A1\u3002DDoS\u653B\u51FB\u5219\u662F\u5229\u7528\u591A\u4E2A\u5206\u5E03\u5F0F\u8282\u70B9\u540C\u65F6\u53D1\u8D77\u653B\u51FB\uFF0C\u5A01\u529B\u66F4\u5927\u3002\r\n\r\n\u4E2D\u95F4\u4EBA\u653B\u51FB\uFF08MITM\uFF09\uFF1A\u4E2D\u95F4\u4EBA\u653B\u51FB\u662F\u6307\u653B\u51FB\u8005\u5728\u901A\u4FE1\u53CC\u65B9\u4E4B\u95F4\u63D2\u5165\u81EA\u5DF1\uFF0C\u7A83\u53D6\u6216\u7BE1\u6539\u901A\u4FE1\u5185\u5BB9\u3002\u5E38\u89C1\u7684MITM\u653B\u51FB\u624B\u6BB5\u5305\u62ECARP\u6B3A\u9A97\u3001DNS\u6B3A\u9A97\u7B49\u3002\r\n\r\n\u793E\u4F1A\u5DE5\u7A0B\u5B66\u653B\u51FB\uFF1A\u793E\u4F1A\u5DE5\u7A0B\u5B66\u653B\u51FB\u5229\u7528\u4EBA\u7C7B\u7684\u5FC3\u7406\u5F31\u70B9\uFF0C\u8BF1\u4F7F\u53D7\u5BB3\u8005\u6CC4\u9732\u654F\u611F\u4FE1\u606F\u6216\u6267\u884C\u67D0\u4E9B\u64CD\u4F5C\u3002\u5E38\u89C1\u7684\u653B\u51FB\u624B\u6BB5\u5305\u62EC\u9493\u9C7C\u90AE\u4EF6\u3001\u5047\u5192\u7F51\u7AD9\u7B49\u3002\r\n\r\n\u96F6\u65E5\u653B\u51FB\uFF1A\u96F6\u65E5\u653B\u51FB\u662F\u6307\u5229\u7528\u5C1A\u672A\u516C\u5F00\u7684\u6F0F\u6D1E\u53D1\u8D77\u7684\u653B\u51FB\u3002\u7531\u4E8E\u6F0F\u6D1E\u5C1A\u672A\u88AB\u4FEE\u590D\uFF0C\u653B\u51FB\u6210\u529F\u7387\u8F83\u9AD8\u3002\r\n\r\n\u5BC6\u7801\u7834\u89E3\uFF1A\u5BC6\u7801\u7834\u89E3\u662F\u653B\u51FB\u8005\u901A\u8FC7\u66B4\u529B\u7834\u89E3\u6216\u5B57\u5178\u653B\u51FB\u7B49\u624B\u6BB5\uFF0C\u83B7\u53D6\u7528\u6237\u7684\u5BC6\u7801\u3002\u5F31\u5BC6\u7801\u6216\u91CD\u590D\u4F7F\u7528\u5BC6\u7801\u7684\u7528\u6237\u66F4\u5BB9\u6613\u6210\u4E3A\u653B\u51FB\u76EE\u6807\u3002\r\n\r\n\u6076\u610F\u8F6F\u4EF6\uFF1A\u6076\u610F\u8F6F\u4EF6\u5305\u62EC\u75C5\u6BD2\u3001\u8815\u866B\u3001\u6728\u9A6C\u7B49\uFF0C\u5B83\u4EEC\u53EF\u4EE5\u901A\u8FC7\u5404\u79CD\u9014\u5F84\u611F\u67D3\u7CFB\u7EDF\uFF0C\u7A83\u53D6\u6570\u636E\u6216\u7834\u574F\u7CFB\u7EDF\u3002"
