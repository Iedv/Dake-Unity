--- !u!114 &1683117298
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1683117296}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: ef85b4c237c8faf4f92d8037bf9e86e5, type: 3}
    m_FontSize: 40
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 4
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "1.1 \u5165\u4FB5\u68C0\u6D4B\u7CFB\u7EDF\uFF08IDS/IPS\uFF09\u7684\u6838\u5FC3\u529F\u80FD\u4E0E\u5B9A\u4F4D\n\u5165\u4FB5\u68C0\u6D4B\u7CFB\u7EDF\uFF08IDS\uFF09\u548C\u5165\u4FB5\u9632\u5FA1\u7CFB\u7EDF\uFF08IPS\uFF09\u662F\u7F51\u7EDC\u5B89\u5168\u9886\u57DF\u4E2D\u7684\u5173\u952E\u7EC4\u4EF6\uFF0C\u4E3B\u8981\u7528\u4E8E\u76D1\u63A7\u3001\u68C0\u6D4B\u548C\u54CD\u5E94\u7F51\u7EDC\u4E2D\u7684\u5F02\u5E38\u884C\u4E3A\u6216\u6F5C\u5728\u7684\u653B\u51FB\u3002IDS\u7684\u6838\u5FC3\u529F\u80FD\u662F\u901A\u8FC7\u5BF9\u7F51\u7EDC\u6D41\u91CF\u3001\u7CFB\u7EDF\u65E5\u5FD7\u3001\u7528\u6237\u884C\u4E3A\u7B49\u6570\u636E\u7684\u5B9E\u65F6\u5206\u6790\uFF0C\u8BC6\u522B\u51FA\u53EF\u80FD\u7684\u5165\u4FB5\u884C\u4E3A\uFF0C\u5E76\u751F\u6210\u76F8\u5E94\u7684\u62A5\u8B66\u3002\u800CIPS\u5219\u5728\u68C0\u6D4B\u5230\u5165\u4FB5\u884C\u4E3A\u540E\uFF0C\u80FD\u591F\u4E3B\u52A8\u91C7\u53D6\u63AA\u65BD\uFF0C\u5982\u963B\u65AD\u6076\u610F\u6D41\u91CF\u6216\u4FEE\u6539\u9632\u706B\u5899\u89C4\u5219\uFF0C\u4EE5\u9632\u6B62\u653B\u51FB\u7684\u8FDB\u4E00\u6B65\u6269\u6563\u3002\r\n\r\nIDS/IPS\u7684\u5B9A\u4F4D\u5728\u4E8E\u5F25\u8865\u4F20\u7EDF\u9632\u706B\u5899\u7684\u4E0D\u8DB3\u3002\u9632\u706B\u5899\u4E3B\u8981\u901A\u8FC7\u9884\u5B9A\u4E49\u7684\u89C4\u5219\u96C6\u6765\u8FC7\u6EE4\u6D41\u91CF\uFF0C\u4F46\u5B83\u65E0\u6CD5\u68C0\u6D4B\u5230\u90A3\u4E9B\u7ED5\u8FC7\u89C4\u5219\u96C6\u7684\u590D\u6742\u653B\u51FB\u3002IDS/IPS\u5219\u901A\u8FC7\u6DF1\u5EA6\u5305\u68C0\u6D4B\uFF08Deep
    Packet Inspection,DPI\uFF09\u548C\u884C\u4E3A\u5206\u6790\u7B49\u6280\u672F\uFF0C\u80FD\u591F\u8BC6\u522B\u51FA\u66F4\u4E3A\u9690\u853D\u7684\u653B\u51FB\u884C\u4E3A\uFF0C\u5982\u96F6\u65E5\u653B\u51FB\u3001\u9AD8\u7EA7\u6301\u7EED\u6027\u5A01\u80C1\uFF08APT\uFF09\u7B49\u3002\r\n\r\nIDS/IPS\u7684\u5DE5\u4F5C\u6D41\u7A0B\u901A\u5E38\u5305\u62EC\u4EE5\u4E0B\u51E0\u4E2A\u6B65\u9AA4\uFF1A\r\n\r\n\u6570\u636E\u91C7\u96C6\uFF1A\u4ECE\u7F51\u7EDC\u8BBE\u5907\u3001\u4E3B\u673A\u7CFB\u7EDF\u3001\u5E94\u7528\u7A0B\u5E8F\u7B49\u4E0D\u540C\u6765\u6E90\u6536\u96C6\u6570\u636E\u3002\r\n\r\n\u6570\u636E\u5206\u6790\uFF1A\u901A\u8FC7\u89C4\u5219\u5339\u914D\u3001\u7EDF\u8BA1\u5206\u6790\u3001\u673A\u5668\u5B66\u4E60\u7B49\u65B9\u6CD5\u5BF9\u6570\u636E\u8FDB\u884C\u5206\u6790\uFF0C\u8BC6\u522B\u5F02\u5E38\u884C\u4E3A\u3002\r\n\r\n\u62A5\u8B66\u751F\u6210\uFF1A\u5F53\u68C0\u6D4B\u5230\u6F5C\u5728\u7684\u5165\u4FB5\u884C\u4E3A\u65F6\uFF0C\u7CFB\u7EDF\u4F1A\u751F\u6210\u62A5\u8B66\uFF0C\u5E76\u8BB0\u5F55\u76F8\u5173\u65E5\u5FD7\u3002\r\n\n\u54CD\u5E94\u63AA\u65BD\uFF1A\u5BF9\u4E8EIPS\u6765\u8BF4\uFF0C\u7CFB\u7EDF\u4F1A\u81EA\u52A8\u91C7\u53D6\u963B\u65AD\u3001\u9694\u79BB\u7B49\u54CD\u5E94\u63AA\u65BD\uFF1B\u800CIDS\u5219\u9700\u8981\u7BA1\u7406\u5458\u624B\u52A8\u4ECB\u5165\u3002\n\n\n1.2
    \u7F51\u7EDC\u5B89\u5168\u8BBE\u5907\uFF08\u9632\u706B\u5899\u3001WAF\u3001IDS\uFF09\u7684\u534F\u540C\u5173\u7CFB\n\u5728\u73B0\u4EE3\u7F51\u7EDC\u73AF\u5883\u4E2D\uFF0C\u5355\u4E00\u7684\u7F51\u7EDC\u5B89\u5168\u8BBE\u5907\u5F80\u5F80\u65E0\u6CD5\u5E94\u5BF9\u590D\u6742\u591A\u53D8\u7684\u653B\u51FB\u624B\u6BB5\u3002\u56E0\u6B64\uFF0C\u9632\u706B\u5899\u3001Web\u5E94\u7528\u9632\u706B\u5899\uFF08WAF\uFF09\u548C\u5165\u4FB5\u68C0\u6D4B\u7CFB\u7EDF\uFF08IDS\uFF09\u7B49\u8BBE\u5907\u9700\u8981\u534F\u540C\u5DE5\u4F5C\uFF0C\u5F62\u6210\u4E00\u4E2A\u591A\u5C42\u6B21\u7684\u5B89\u5168\u9632\u62A4\u4F53\u7CFB\u3002\r\n\r\n\u9632\u706B\u5899\u662F\u7F51\u7EDC\u5B89\u5168\u7684\u7B2C\u4E00\u9053\u9632\u7EBF\uFF0C\u4E3B\u8981\u8D1F\u8D23\u6839\u636E\u9884\u5B9A\u4E49\u7684\u89C4\u5219\u96C6\u8FC7\u6EE4\u8FDB\u51FA\u7F51\u7EDC\u7684\u6D41\u91CF\u3002\u5B83\u53EF\u4EE5\u963B\u6B62\u672A\u7ECF\u6388\u6743\u7684\u8BBF\u95EE\uFF0C\u4F46\u65E0\u6CD5\u68C0\u6D4B\u5230\u90A3\u4E9B\u901A\u8FC7\u5408\u6CD5\u7AEF\u53E3\u548C\u534F\u8BAE\u8FDB\u884C\u7684\u653B\u51FB\u3002\r\n\r\nWeb\u5E94\u7528\u9632\u706B\u5899\uFF08WAF\uFF09\u4E13\u95E8\u7528\u4E8E\u4FDD\u62A4Web\u5E94\u7528\u7A0B\u5E8F\uFF0C\u80FD\u591F\u8BC6\u522B\u548C\u963B\u6B62\u5E38\u89C1\u7684Web\u653B\u51FB\uFF0C\u5982SQL\u6CE8\u5165\u3001\u8DE8\u7AD9\u811A\u672C\uFF08XSS\uFF09\u7B49\u3002WAF\u901A\u5E38\u90E8\u7F72\u5728Web\u670D\u52A1\u5668\u4E4B\u524D\uFF0C\u76D1\u63A7\u6240\u6709\u8FDB\u51FAWeb\u5E94\u7528\u7684HTTP/HTTPS\u6D41\u91CF\u3002\r\n\r\n\u5165\u4FB5\u68C0\u6D4B\u7CFB\u7EDF\uFF08IDS\uFF09\u5219\u662F\u5BF9\u9632\u706B\u5899\u548CWAF\u7684\u8865\u5145\uFF0C\u5B83\u901A\u8FC7\u6DF1\u5EA6\u5206\u6790\u7F51\u7EDC\u6D41\u91CF\u548C\u7CFB\u7EDF\u65E5\u5FD7\uFF0C\u8BC6\u522B\u51FA\u90A3\u4E9B\u7ED5\u8FC7\u9632\u706B\u5899\u548CWAF\u7684\u590D\u6742\u653B\u51FB\u3002IDS\u53EF\u4EE5\u90E8\u7F72\u5728\u7F51\u7EDC\u7684\u5173\u952E\u8282\u70B9\uFF0C\u76D1\u63A7\u5185\u90E8\u7F51\u7EDC\u548C\u5916\u90E8\u7F51\u7EDC\u4E4B\u95F4\u7684\u6240\u6709\u6D41\u91CF\u3002\r\n\r\n\u8FD9\u4E09\u79CD\u8BBE\u5907\u7684\u534F\u540C\u5DE5\u4F5C\u53EF\u4EE5\u5F62\u6210\u4E00\u4E2A\u7EB5\u6DF1\u9632\u5FA1\u4F53\u7CFB\uFF1A\r\n\r\n\u9632\u706B\u5899\u8D1F\u8D23\u521D\u6B65\u7684\u6D41\u91CF\u8FC7\u6EE4\uFF0C\u963B\u6B62\u660E\u663E\u7684\u6076\u610F\u6D41\u91CF\u3002\r\nWAF\u4E13\u6CE8\u4E8E\u4FDD\u62A4Web\u5E94\u7528\uFF0C\u9632\u6B62\u5E38\u89C1\u7684Web\u653B\u51FB\u3002\r\nIDS\u5219\u901A\u8FC7\u6DF1\u5EA6\u5206\u6790\uFF0C\u8BC6\u522B\u51FA\u90A3\u4E9B\u9690\u853D\u7684\u653B\u51FB\u884C\u4E3A\uFF0C\u5E76\u63D0\u4F9B\u8BE6\u7EC6\u7684\u62A5\u8B66\u4FE1\u606F\u3002\r\n\r\n\u901A\u8FC7\u8FD9\u79CD\u534F\u540C\u5DE5\u4F5C\uFF0C\u7F51\u7EDC\u7684\u5B89\u5168\u6027\u5F97\u5230\u4E86\u6781\u5927\u7684\u63D0\u5347\uFF0C\u80FD\u591F\u6709\u6548\u5E94\u5BF9\u5404\u79CD\u590D\u6742\u7684\u653B\u51FB\u624B\u6BB5\u3002"
